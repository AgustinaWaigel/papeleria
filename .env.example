# Copiá este archivo como .env.local y completá con los datos de tu proyecto:
# Supabase → Project Settings → API (o el botón "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Si tu proyecto es anterior a las claves publicables, usá la "anon key":
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Pago online con Mercado Pago (ver supabase/LEEME.md, "Pago online"). Sin estas dos, la bolsita ofrece
# solo WhatsApp. Ninguna lleva NEXT_PUBLIC_: son secretas y nunca llegan al navegador.
# Supabase → Project Settings → API Keys → Secret key (o la "service_role" si tu proyecto es viejo):
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Mercado Pago → Tus integraciones → tu aplicación → Credenciales (primero las de prueba, TEST-…):
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# Mail con los PDF de los descargables (ver supabase/LEEME.md, "Mail con los PDF"). Sale de esta casilla
# de Gmail. La clave NO es la de tu cuenta: es una "contraseña de aplicación" de 16 letras.
# GMAIL_USUARIO=papeleria.alasdeangel@gmail.com
# GMAIL_CLAVE_APP=xxxx xxxx xxxx xxxx
# Opcional: a dónde te llegan los avisos de cada venta y de cada arrepentimiento (por defecto, GMAIL_USUARIO).
# MAIL_AVISOS=tu-mail-personal@gmail.com

# Opcional: cotización en vivo con Correo Argentino (API MiCorreo, ver supabase/LEEME.md). Sin esto, el envío
# sale de las zonas del panel. Las credenciales de la API las da Correo Argentino a pedido y son distintas en
# cada ambiente (primero "prueba", después "produccion").
# CORREO_AMBIENTE=prueba
# CORREO_API_USUARIO=xxxxxxxx
# CORREO_API_CLAVE=xxxxxxxx
# Tu cuenta de MiCorreo (o, si ya lo sabés, el número de cliente en CORREO_CUSTOMER_ID):
# CORREO_MICORREO_EMAIL=papeleria.alasdeangel@gmail.com
# CORREO_MICORREO_CLAVE=xxxxxxxx
# Desde dónde despachás (por defecto, Paraná):
# CORREO_CP_ORIGEN=3100

# La dirección pública de la tienda (para Google y para los links que se comparten).
# En Vercel no hace falta: se toma sola del dominio principal.
NEXT_PUBLIC_SITIO_URL=https://www.alasdeangel.com.ar

# Opcional: el código de Google Search Console (método "Etiqueta HTML"), solo lo que va en content="…".
# NEXT_PUBLIC_GOOGLE_VERIFICACION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
