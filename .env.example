# Copiá este archivo como .env.local y completá con los datos de tu proyecto:
# Supabase → Project Settings → API (o el botón "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Si tu proyecto es anterior a las claves publicables, usá la "anon key":
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# La dirección pública de la tienda (para Google y para los links que se comparten).
# En Vercel no hace falta: se toma sola del dominio principal.
NEXT_PUBLIC_SITIO_URL=https://www.alasdeangel.com.ar
