# ─────────────────────────────────────────────────────────────────────────────
# Rubro: PAPELERÍA — Alas de Ángel (el diseño original)
# Copiá este archivo para un rubro nuevo. Cualquier variable que pongas en
# .env.local (o en Vercel) pisa la de acá.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identidad ──
MARCA_NOMBRE="Alas de Ángel"
MARCA_RUBRO="Papelería"
MARCA_LEMA="Para escribir, soñar y volar."
MARCA_DESCRIPCION="Cuadernos, agendas, stickers y plantillas para imprimir. Papelería hecha a mano para escribir, soñar y volar."
MARCA_NOTA="papelería creativa"
# Nombre corto para el resumen de la tarjeta (Mercado Pago, máx. 22 letras, sin tildes)
MARCA_DESCRIPTOR="ALAS DE ANGEL"
# Logo: "alas" (el original), "inicial" (la primera letra en un cuadrado) o la ruta de una imagen en /public (/logo.png)
MARCA_LOGO="alas"
# Dibujo de la portada: "alas", "logo", "ninguno" o la ruta de una imagen en /public (/portada.png)
MARCA_ILUSTRACION="alas"
# Cabecera de los mails: ruta de una imagen en /public, o vacío para una franja de color con el nombre
MARCA_MAIL_CABECERA="/mail-cabecera.png"

# ── Portada ──
PORTADA_TITULO="Para escribir, soñar y"
PORTADA_RESALTE="volar."
PORTADA_TEXTO="Papelería hecha a mano, con mucho amor. Cuadernos, agendas, cartucheras y detalles para acompañar tus días."
PORTADA_NOTA_DESTACADOS="recién salidos del taller"
PORTADA_TITULO_DESTACADOS="Lo que hay en la mesa"

# ── Catálogo ──
# Dirección de la página de productos físicos (alasdeangel.com.ar/papeleria)
CATALOGO_RUTA="papeleria"
CATALOGO_NOMBRE="Papelería"
CATALOGO_TEXTO="Cuadernos cosidos, agendas, stickers, washi tapes y lapiceras. Te llegan a tu casa."
CATALOGO_BOTON="Ver la papelería"
# Encabezado de la página del catálogo
CATALOGO_NOTA="para organizarte, divertirte o regalar (te)"
CATALOGO_INTRO="Cuadernos, agendas, stickers y todo lo que hace falta para que escribir a mano vuelva a dar ganas. Te lo mandamos envuelto a tu casa."
# Qué secciones están abiertas (separadas por coma): descargables, personalizados, packs, ideas, listas, por-mayor
SECCIONES_ABIERTAS="descargables,personalizados,por-mayor"

# ── Contacto ──
# WhatsApp con código de país y sin signos: 54 9 + característica + número
CONTACTO_WHATSAPP="5493434042410"
CONTACTO_EMAIL="papeleria.alasdeangel@gmail.com"
CONTACTO_INSTAGRAM="alasdeangel.papeleria"
CONTACTO_TIKTOK="alasdeangel.papeleria"

# ── Colores ──
COLOR_FONDO="#F6E7D4"
COLOR_FONDO_ALT="#F9D5E4"
COLOR_TEXTO="#0B5E41"
COLOR_TEXTO_SUAVE="#2F6E55"
COLOR_LINEA="#E3CDB6"
COLOR_PRINCIPAL="#7F2350"
COLOR_PRINCIPAL_FUERTE="#6A1B42"
COLOR_PRINCIPAL_SUAVE="#EBC3D6"
COLOR_ACENTO="#B9D53B"
COLOR_ACENTO_SUAVE="#E6F0B4"
COLOR_SECUNDARIO="#F4A9CB"
COLOR_SECUNDARIO_SUAVE="#FBDCE9"
COLOR_TERCIARIO="#7CC4A0"
COLOR_TERCIARIO_SUAVE="#D5EEDF"

# ── Tipografías (nombres exactos de Google Fonts) ──
FUENTE_TITULOS="Londrina Solid"
FUENTE_TEXTO="Karla"
FUENTE_ETIQUETAS="Baloo 2"
# Vacío = usa la de etiquetas
FUENTE_MANO="La Belle Aurore"
TITULOS_MAYUSCULAS="si"
# Multiplica todos los tamaños de letra (1 = normal, 1.1 = 10 % más grande)
TEXTO_ESCALA="1"

# ── Estilo ──
ESTILO_RADIO_CHICO="6px"
ESTILO_RADIO="14px"
ESTILO_RADIO_GRANDE="28px"
# Botones y etiquetas: "999px" = pastilla, o el radio que quieras
ESTILO_RADIO_PASTILLA="999px"
ESTILO_LINEA="1.5px"
# Sombra: "sello" (sólida, corrida), "suave" (difusa) o "ninguna"
ESTILO_SOMBRA="sello"
ESTILO_SOMBRA_DESPLAZAMIENTO="4px"
# Patrón dibujado de fondo en la portada: "si" o "no"
ESTILO_PATRON="si"
ESTILO_ANCHO="72rem"
